# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` to version control.

SECRET_KEY=change-this-to-a-long-random-string
DATABASE_URL=sqlite:///instance/smartbill.db

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# OTP delivery: "console" (demo, no account needed) or "twilio"
SMS_PROVIDER=console
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM_NUMBER=

# Google OAuth (console.cloud.google.com -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# UPI
UPI_MERCHANT_VPA=smartbill@upi
UPI_MERCHANT_NAME=SmartBill Split

# Razorpay (optional, for hosted payment links / cards)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email (optional, for email notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
